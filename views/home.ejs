<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>HealthBot – Your AI Medical Assistant</title>
    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        body {
            font-family: "Inter", sans-serif;
            background: radial-gradient(circle at top, #dbeafe, #f8fafc);
            overflow-x: hidden;
        }

        /* Cursor Parallax Orbs */
        .orb {
            position: fixed;
            width: 400px;
            height: 400px;
            border-radius: 50%;
            filter: blur(120px);
            opacity: 0.55;
            pointer-events: none;
            transition: transform 0.15s ease-out;
        }

        #orb1 {
            background: #60a5fa;
        }

        #orb2 {
            background: #34d399;
        }

        #orb3 {
            background: #a78bfa;
        }

        /* Fade-in on scroll */
        .reveal {
            opacity: 0;
            transform: translateY(40px);
            transition: all 0.9s ease;
        }

        .reveal.visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* Parallax floating cards */
        .float {
            transition: transform 0.3s ease-out;
        }

        .float:hover {
            transform: translateY(-8px) scale(1.03);
        }

        /* Glass */
        .glass {
            background: rgba(255, 255, 255, 0.65);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.4);
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
        }
    </style>
</head>

<body>

    <!-- MOVING BACKGROUND ORBS -->
    <div id="orb1" class="orb"></div>
    <div id="orb2" class="orb"></div>
    <div id="orb3" class="orb"></div>

    <!-- HERO SECTION -->
    <section class="min-h-[85vh] flex flex-col justify-center items-center text-center px-6 relative z-10">
        <h1 class="text-6xl md:text-7xl font-extrabold text-blue-700 tracking-tight mb-6 reveal">
            HealthBot AI Doctor
        </h1>

        <p class="text-gray-700 text-xl md:text-2xl max-w-3xl leading-relaxed reveal">
            Advanced AI-powered medical analysis that delivers instant health insights.
            Experience the future of healthcare—fast, private, intelligent.
        </p>

        <a href="/form" class="reveal">
            <button class="mt-10 px-10 py-5 rounded-full bg-blue-600 text-white text-2xl font-semibold shadow-lg hover:bg-blue-700 transition">
                Start Health Check →
            </button>
        </a>

        <!-- Floating 3D Elements -->
        <div class="absolute top-20 right-10 w-40 h-40 bg-blue-300 rounded-full opacity-30 blur-2xl animate-pulse"></div>
        <div class="absolute bottom-20 left-10 w-40 h-40 bg-purple-300 rounded-full opacity-30 blur-2xl animate-pulse"></div>
    </section>

    <!-- FEATURES SECTION -->
    <section class="px-6 py-20 max-w-6xl mx-auto reveal">
        <h2 class="text-4xl font-bold text-center text-blue-700 mb-14">Why Choose HealthBot?</h2>

        <div class="grid md:grid-cols-3 gap-10">
            <div class="glass p-8 rounded-2xl text-center float">
                <h3 class="text-2xl font-semibold text-blue-700 mb-3">⚡ Instant AI Diagnosis</h3>
                <p class="text-gray-700 text-base">
                    Submit symptoms & vitals and get a medical-grade AI report within seconds.
                </p>
            </div>

            <div class="glass p-8 rounded-2xl text-center float">
                <h3 class="text-2xl font-semibold text-blue-700 mb-3">🧠 Smart Health Analysis</h3>
                <p class="text-gray-700 text-base">
                    The model reads patterns, compares conditions & generates accurate insights.
                </p>
            </div>

            <div class="glass p-8 rounded-2xl text-center float">
                <h3 class="text-2xl font-semibold text-blue-700 mb-3">🌐 Multilingual Support</h3>
                <p class="text-gray-700 text-base">
                    Available in English, Hindi & Marathi. More languages coming soon.
                </p>
            </div>
        </div>
    </section>

    <!-- HOW IT WORKS -->
    <section class="px-6 py-20 text-center reveal relative">
        <h2 class="text-4xl font-bold text-blue-700 mb-14">How It Works</h2>

        <div class="grid md:grid-cols-3 gap-12 max-w-5xl mx-auto">

            <div class="glass p-8 rounded-2xl float">
                <h3 class="text-2xl font-semibold text-blue-700 mb-3">1. Enter Details</h3>
                <p class="text-gray-700">
                    Fill basic info, symptoms & vitals using our modern form.
                </p>
            </div>

            <div class="glass p-8 rounded-2xl float">
                <h3 class="text-2xl font-semibold text-blue-700 mb-3">2. AI Processes Inputs</h3>
                <p class="text-gray-700">
                    HealthBot uses deep medical models to assess your condition.
                </p>
            </div>

            <div class="glass p-8 rounded-2xl float">
                <h3 class="text-2xl font-semibold text-blue-700 mb-3">3. Instant Report</h3>
                <p class="text-gray-700">
                    Get a clean, easy-to-read health report with recommendations.
                </p>
            </div>
        </div>

        <a href="/form">
            <button class="mt-12 px-12 py-5 rounded-full bg-blue-600 text-white text-2xl font-semibold shadow-lg hover:bg-blue-700 transition">
                Generate My Report →
            </button>
        </a>
    </section>

    <!-- FOOTER -->
    <footer class="py-8 text-center text-gray-600 text-sm reveal">
        <p>© 2025 HealthBot AI. All rights reserved.</p>
        <p class="italic text-xs mt-2">
            Disclaimer: AI-generated medical suggestions should not replace certified medical advice.
        </p>
    </footer>

    <!-- JAVASCRIPT FOR INTERACTIONS -->
    <script>
        // Move background orbs with cursor
        const orbs = [document.getElementById("orb1"), document.getElementById("orb2"), document.getElementById("orb3")];

        document.addEventListener("mousemove", (e) => {
            orbs.forEach((orb, index) => {
                const speed = (index + 1) * 0.05;
                orb.style.transform = `translate(${e.clientX * speed}px, ${e.clientY * speed}px)`;
            });
        });

        // Fade-in on scroll
        const reveals = document.querySelectorAll(".reveal");

        function revealOnScroll() {
            reveals.forEach((el) => {
                const rect = el.getBoundingClientRect();
                if (rect.top < window.innerHeight - 80) {
                    el.classList.add("visible");
                }
            });
        }

        window.addEventListener("scroll", revealOnScroll);
        revealOnScroll();
    </script>

</body>
</html>
